---
const groups = [
  {
    title: "editors",
    proto: "via LSP",
    tools: ["VS Code", "Cursor", "Neovim", "Helix", "JetBrains", "VSCodium", "Windsurf"],
  },
  {
    title: "AI assistants",
    proto: "via MCP",
    tools: ["Claude Code", "Cursor Agent", "Cline", "Codex", "Windsurf", "Gemini CLI", "GitHub Copilot", "…and more"],
  },
  {
    title: "continuous integration",
    proto: "as CLI",
    tools: ["GitHub Actions", "npm scripts", "pre-commit", "Husky", "lint-staged"],
  },
];
---

<section class="rule-top bg-paper" id="integrations">
  <div class="container-edit py-24 md:py-32">
    <div class="grid md:grid-cols-12 gap-8 md:gap-12 mb-16">
      <div class="md:col-span-3">
        <div class="sct-numeral">§ 006</div>
        <div class="sct-numeral mt-1 opacity-60">// INTEGRATIONS</div>
      </div>
      <div class="md:col-span-9 min-w-0">
        <h2 class="display-l">
          Plugs into the<br />
          <span class="text-accent">tools you already use.</span>
        </h2>
        <p class="body-lead mt-10 max-w-2xl">
          One core engine, three protocols. No editor lock-in, no AI vendor
          lock-in.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 border border-ink">
      {groups.map((g, i) => (
        <div class={`pt-7 pb-7 px-6 min-w-0 ${i > 0 ? 'md:border-l md:border-ink border-t md:border-t-0 border-ink' : ''}`}>
          <div class="flex items-baseline gap-3 mb-5 pb-3 border-b border-rule">
            <h3 class="display-m">{g.title}</h3>
            <span class="font-mono text-[0.7rem] text-mute">[{g.proto}]</span>
          </div>
          <ul class="space-y-2">
            {g.tools.map(t => (
              <li class="flex items-baseline gap-3 text-[0.95rem]">
                <span class="font-mono text-mute text-xs shrink-0">→</span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
