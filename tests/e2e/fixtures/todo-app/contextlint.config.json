{
  "$schema": "../../../../schema.json",
  "include": ["docs/**/*.md"],
  "rules": [
    {
      "rule": "tbl001",
      "options": {
        "requiredColumns": ["ID", "Requirement", "Stability"],
        "files": "requirements.md"
      }
    },
    {
      "rule": "tbl001",
      "options": {
        "requiredColumns": ["No", "Column", "Type", "Stability"],
        "section": "Column Definition",
        "files": "table_*.md"
      }
    },
    {
      "rule": "tbl003",
      "options": {
        "column": "Stability",
        "values": ["draft", "review", "stable"]
      }
    },
    {
      "rule": "tbl004",
      "options": {
        "column": "ID",
        "pattern": "^REQ-",
        "files": "requirements.md"
      }
    },
    {
      "rule": "tbl005",
      "options": {
        "when": { "column": "Stability", "equals": "stable" },
        "then": { "column": "Rationale", "notEmpty": true },
        "files": "requirements.md"
      }
    },
    {
      "rule": "tbl006",
      "options": {
        "files": "requirements.md",
        "column": "ID",
        "idPattern": "^REQ-"
      }
    },
    {
      "rule": "sec001",
      "options": {
        "sections": ["Responsibilities", "Out of Scope"],
        "files": "overview.md"
      }
    },
    {
      "rule": "sec001",
      "options": {
        "sections": ["Business Value (Why)", "Requirements (What)", "Specification (Spec)"],
        "files": "table_*.md"
      }
    },
    {
      "rule": "sec002",
      "options": {
        "order": ["Business Value (Why)", "Requirements (What)", "Specification (Spec)", "Design (How)"],
        "files": "table_*.md"
      }
    },
    {
      "rule": "str001",
      "options": {
        "files": [
          "docs/zones/task/overview.md",
          "docs/zones/task/requirements.md",
          "docs/zones/auth/overview.md",
          "docs/zones/auth/requirements.md"
        ]
      }
    },
    {
      "rule": "ref001"
    },
    {
      "rule": "ref005"
    },
    {
      "rule": "ctx001",
      "options": {
        "files": "overview.md"
      }
    },
    {
      "rule": "ctx002",
      "options": {
        "glossary": "glossary.md",
        "termColumn": "Term",
        "aliasColumn": "Aliases"
      }
    },
    {
      "rule": "grp002",
      "options": {
        "exclude": ["screen_task_detail.md"]
      }
    },
    {
      "rule": "grp003",
      "options": {
        "entryPoints": ["overview.md", "glossary.md"]
      }
    }
  ]
}
