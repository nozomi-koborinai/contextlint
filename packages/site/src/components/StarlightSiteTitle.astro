---
import config from "virtual:starlight/user-config";

interface Props {
  locale: string | undefined;
}

const { locale } = Astro.props;

const title =
  (locale && config.title[locale]) ||
  config.title["en"] ||
  Object.values(config.title)[0] ||
  "contextlint";
---

<a href="/" class="site-title">
  <span class="site-title-text">{title}</span>
</a>

<style>
  .site-title {
    font-family: "Funnel Display", "Inter Tight", system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-title:hover {
    color: var(--sl-color-accent);
  }
</style>
