---
---

<section class="rule-top bg-paper">
  <div class="container-edit py-24 md:py-32">
    <div class="grid md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-3">
        <div class="sct-numeral">§ 007</div>
        <div class="sct-numeral mt-1 opacity-60">// ORIGIN</div>
      </div>
      <div class="md:col-span-9">
        <h2 class="display-l">
          Built from <span class="text-accent">lived practice.</span>
        </h2>

        <blockquote class="mt-14 max-w-3xl callout">
          <div class="callout-label">[testimony:001]</div>
          <p class="display-m mt-3" style="font-weight: 480;">
            "I practice spec-driven development at work. Maintaining
            consistency across hundreds of Markdown files is a real
            problem — broken cross-references and duplicate IDs go
            undetected. So I built contextlint to solve it."
          </p>
        </blockquote>

        <div class="flex items-center gap-4 mt-12">
          <div class="w-12 h-px bg-ink"></div>
          <div>
            <div class="font-display text-base" style="font-weight: 600;">Nozomi Koborinai</div>
            <div class="font-mono text-[0.7rem] text-mute uppercase tracking-widest">Author · <a href="https://koborin.ai" class="link-mark text-ink">koborin.ai</a></div>
          </div>
        </div>

        <p class="body-lead mt-16 max-w-3xl text-mute">
          contextlint is open source. Contributions, rule proposals,
          and bug reports are welcome on
          <a href="https://github.com/nozomi-koborinai/contextlint" class="link-mark text-ink">GitHub</a>.
        </p>
      </div>
    </div>
  </div>
</section>
